#include "fp_config_user.h"
#include "cmsis_os2.h" // the example usage in this file relies on a CMSIS-compliant RTOS
#include "fp_disp_session_mgr.h"

static const osMutexAttr_t fp_mutex_attr = {
    "fp_mutex",
    osMutexRecursive | osMutexPrioInherit,
    NULL,
    0U
};

static osMutexId_t rs485_os_locks[FP_LOCK_SECTION_MAX];

